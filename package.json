{
  "name": "fishquest",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:sync": "npm run build && cap sync android",
    "android:build": "python3 scripts/build-android.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.52.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
